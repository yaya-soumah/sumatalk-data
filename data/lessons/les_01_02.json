    },
    {
      "sentence_id": "s_05",
      "english": "My first name is Kevin.",
      "chinese": "我的名字是 Kevin。",
      "audio_url": "les_01_02_s_05_my_first_name_is_kev.mp3"
    },
    {
      "sentence_id": "s_06",
      "english": "My last name is Wang.",
      "chinese": "我姓王。",
      "audio_url": "les_01_02_s_06_my_last_name_is_wang.mp3"
    },
    {
      "sentence_id": "s_07",
      "english": "Nice to meet you.",
      "chinese": "很高兴见到你。",
      "audio_url": "les_01_02_s_07_nice_to_meet_you.mp3"
    },
    {
      "sentence_id": "s_08",
      "english": "Let me introduce myself.",
      "chinese": "让我介绍一下自己。",
      "audio_url": "les_01_02_s_08_let_me_introduce_mys.mp3"
    },
    {
      "sentence_id": "s_09",
      "english": "I am a student.",
      "chinese": "我是一名学生。",
      "audio_url": "les_01_02_s_09_i_am_a_student.mp3"
    },
    {
      "sentence_id": "s_10",
      "english": "She is my friend.",
      "chinese": "她是我的朋友。",
      "audio_url": "les_01_02_s_10_she_is_my_friend.mp3"
    },
    {
      "sentence_id": "s_11",
      "english": "His name is Peter.",
      "chinese": "他的名字是彼得。",
      "audio_url": "les_01_02_s_11_his_name_is_peter.mp3"
    },
    {
      "sentence_id": "s_12",
      "english": "Her nickname is Jenny.",
      "chinese": "她的昵称是珍妮。",
      "audio_url": "les_01_02_s_12_her_nickname_is_jenn.mp3"
    },
    {
      "sentence_id": "s_13",
      "english": "Can you spell your name?",
      "chinese": "你能拼写你的名字吗？",
      "audio_url": "les_01_02_s_13_can_you_spell_your_n.mp3"
    },
    {
