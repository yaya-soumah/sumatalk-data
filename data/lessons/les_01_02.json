  "sentences": [
    {
      "sentence_id": "s_01",
      "english": "My name is Kevin.",
      "chinese": "我的名字是汤姆。",
      "audio_url": "les_01_02_s_01_my_name_is_kevin.mp3"
    },
    {
      "sentence_id": "s_02",
      "english": "My full name is Kevin Ming Wang.",
      "chinese": "我的名字是 Kevin Ming Wang。",
      "audio_url": "les_01_02_s_02_my_full_name_is_kevi.mp3"
    },
    {
      "sentence_id": "s_03",
      "english": "I am Sarah.",
      "chinese": "我是杰克。",
      "audio_url": "les_01_02_s_03_i_am_sarah.mp3"
    },
    {
      "sentence_id": "s_04",
      "english": "You can call me Kev.",
      "chinese": "你可以叫我 kev。",
