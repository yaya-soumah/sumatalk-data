      "audio_url": "les_01_02_dialogue_6_can_you_spell_your_n.mp3"
    },
    {
      "role": "B",
      "text_en": "Sure. K-E-V-I-N.",
      "text_zh": "当然。K-E-V-I-N。",
      "audio_url": "les_01_02_dialogue_7_sure_kevin.mp3"
    },
    {
      "role": "A",
      "text_en": "Thank you.",
      "text_zh": "谢谢你。",
      "audio_url": "les_01_02_dialogue_8_thank_you.mp3"
    },
    {
      "role": "B",
      "text_en": "You're welcome.",
      "text_zh": "不客气。",
      "audio_url": "les_01_02_dialogue_9_youre_welcome.mp3"
    },
    {
      "role": "A",
      "text_en": "What do your friends call you?",
      "text_zh": "你的朋友们怎么称呼你？",
      "audio_url": "les_01_02_dialogue_10_what_do_your_friends.mp3"
