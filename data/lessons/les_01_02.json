      "audio_url": "les_01_02_s_14_my_name_is_easy_to_s.mp3"
    },
    {
      "sentence_id": "s_15",
      "english": "Welcome to our class.",
      "chinese": "欢迎来到我们的班级。",
      "audio_url": "les_01_02_s_15_welcome_to_our_class.mp3"
